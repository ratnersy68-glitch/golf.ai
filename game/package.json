{
  "name": "mini-majors",
  "private": true,
  "version": "0.1.0",
  "description": "Real, famous golf holes shrunk down into 3D mini-golf.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate-holes": "vitest run tests/holeReachability.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
